{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "PrepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestKey",
        "clientId",
        "currency",
        "direction",
        "windowStart",
        "asOf",
        "ingestedBefore"
      ],
      "properties": {
        "requestKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "clientId": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "direction": {
          "enum": [
            "IN",
            "OUT"
          ]
        },
        "windowStart": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        },
        "ingestedBefore": {
          "type": "string"
        }
      }
    },
    "PageRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId"
      ],
      "properties": {
        "snapshotId": {
          "type": "string"
        },
        "pageToken": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "digest",
        "itemCount",
        "capturedAt",
        "coverage",
        "selection"
      ],
      "properties": {
        "snapshotId": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "capturedAt": {
          "type": "string"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "revision",
            "intervals",
            "declaredBySource"
          ],
          "properties": {
            "mode": {
              "enum": [
                "UNKNOWN",
                "FIRST_SEEN_ONLY",
                "DECLARED_COMPLETE"
              ]
            },
            "revision": {
              "type": "string"
            },
            "declaredBySource": {
              "type": [
                "string",
                "null"
              ]
            },
            "intervals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                }
              }
            },
            "hourIntervals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                }
              }
            },
            "gaps": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accountsWithoutScope",
                "day",
                "hour"
              ],
              "properties": {
                "accountsWithoutScope": {
                  "type": "integer",
                  "minimum": 0
                },
                "day": {
                  "type": "integer",
                  "minimum": 0
                },
                "hour": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "selection": {
          "$ref": "#/$defs/PrepareRequest"
        }
      }
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clientId",
        "accountId",
        "counterpartyId",
        "amount",
        "currency",
        "direction",
        "occurredAt",
        "ingestedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "clientId": {
          "type": "string"
        },
        "accountId": {
          "type": "string"
        },
        "counterpartyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "direction": {
          "enum": [
            "IN",
            "OUT"
          ]
        },
        "occurredAt": {
          "type": "string"
        },
        "ingestedAt": {
          "type": "string"
        },
        "timePrecision": {
          "enum": [
            "EXACT",
            "DATE"
          ]
        },
        "operationKind": {
          "enum": [
            "PURCHASE",
            "TRANSFER",
            "WITHDRAWAL",
            "DEPOSIT",
            "REFUND",
            "REVERSAL"
          ]
        },
        "operationChannel": {
          "enum": [
            "POS",
            "ONLINE",
            "ATM",
            "BRANCH",
            "BANK_API",
            "UNKNOWN"
          ]
        }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "digest",
        "itemCount",
        "items",
        "nextPageToken"
      ],
      "properties": {
        "snapshotId": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "itemCount": {
          "$ref": "#/$defs/Snapshot/properties/itemCount"
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        "nextPageToken": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
