{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "transaction_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "data_status": {
          "enum": [
            "SUFFICIENT",
            "INSUFFICIENT"
          ]
        },
        "calculated_at": {
          "type": "string",
          "format": "date-time"
        },
        "assessment_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "assessment_status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE"
          ]
        },
        "assessment_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "review_required": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "result_id",
        "transaction_id",
        "client_id",
        "run_id",
        "score",
        "threshold",
        "data_status",
        "calculated_at"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "assessment_status"
            ]
          },
          "then": {
            "required": [
              "assessment_score",
              "assessment_status",
              "assessment_policy_version",
              "review_required"
            ]
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analysis.completed.v1"
}
