{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "transaction_id",
        "client_id",
        "case_version",
        "review_cycle",
        "case_state",
        "decision",
        "state_changed_at"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "transaction_id": {
          "type": "string",
          "format": "uuid"
        },
        "client_id": {
          "type": "string",
          "format": "uuid"
        },
        "case_version": {
          "type": "integer",
          "minimum": 1
        },
        "review_cycle": {
          "type": "integer",
          "minimum": 1
        },
        "case_state": {
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "state_changed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "outcome",
                "decided_at"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "outcome": {
                  "enum": [
                    "EXPLAINED",
                    "UNUSUAL_CONFIRMED"
                  ]
                },
                "decided_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "case_state": {
                "const": "OPEN"
              }
            }
          },
          "then": {
            "properties": {
              "decision": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "case.feedback.v1"
}
