# Run tools/init_env.ps1 or run.ps1 to create .env with independent random values.
# These are setting names, not usable passwords. Existing credentials are retained.
DB_PASSWORD=generate_with_init_env
REDIS_PASSWORD=generate_with_init_env
JWT_SECRET=generate_with_init_env
SERVICE_TOKEN=generate_with_init_env
PGADMIN_PASSWORD=generate_with_init_env
REPORT_SIGNING_KEY=generate_with_init_env
